# Included at the end of the reviewed top-level recipe.
# Generates actual resolved ExternalProject dependency edges for CI comparison.
if(NOT IS_DIRECTORY "${EVIDENCE_DIR}")
  message(FATAL_ERROR "Evidence directory is required")
endif()
function(ef_collect_directory directory)
  get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
  foreach(target IN LISTS targets)
    get_property(source TARGET "${target}" PROPERTY _EP_SOURCE_DIR)
    if(source)
      get_property(deps TARGET "${target}" PROPERTY _EP_DEPENDS)
      string(REPLACE ";" "\",\"" deps_json "${deps}")
      if(deps)
        set(values "\"${deps_json}\"")
      else()
        set(values "")
      endif()
      set_property(GLOBAL APPEND PROPERTY EF_GRAPH_ROWS "\"${target}\":[${values}]")
    endif()
  endforeach()
  get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
  foreach(child IN LISTS children)
    ef_collect_directory("${child}")
  endforeach()
endfunction()
if(EXISTS "${EVIDENCE_DIR}/configured-graph.json")
  message(FATAL_ERROR "Refusing evidence overwrite")
endif()
ef_collect_directory("${CMAKE_SOURCE_DIR}")
get_property(rows GLOBAL PROPERTY EF_GRAPH_ROWS)
string(REPLACE ";" ",\n" body "${rows}")
file(WRITE "${EVIDENCE_DIR}/configured-graph.json" "{${body}}\n")
